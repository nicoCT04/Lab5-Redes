# Lab 5 sobre QEMU/KVM en WSL2.  Uso: just -f infra-qemu/justfile <receta>

# Lista de recetas
default:
    @just --list --justfile {{justfile()}}

# Una sola vez por equipo (pide sudo): QEMU, grupo kvm, red br-lab5 y dominio en /etc/hosts
requisitos:
    sudo bash requisitos.sh

# Crea (si no existen) y arranca lab5-web y lab5-db
vms:
    ./crear-vms.sh

# Despliega todo el laboratorio por SSH (agregar --certificado para el de Let's Encrypt real)
desplegar *opciones:
    ./desplegar.sh {{opciones}}

# Solo las pruebas de funcionamiento
pruebas:
    ./desplegar.sh --solo-pruebas

apagar:
    ./crear-vms.sh --apagar

# Apaga y elimina los discos de las VM (la imagen base se conserva)
borrar:
    ./crear-vms.sh --borrar
