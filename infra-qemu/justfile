# Lab 5 con QEMU/KVM. Uso: just -f infra-qemu/justfile <receta>

# Lista de recetas
default:
    @just --list --justfile {{justfile()}}

# Una sola vez (pide sudo): QEMU, grupo kvm, red br-lab5 y dominio en /etc/hosts
requisitos:
    sudo bash requisitos.sh

# Crea (si no existen) y arranca lab5-web y lab5-db
vms:
    ./crear-vms.sh

# Despliegue completo por SSH (--certificado pide el certificado real)
desplegar *opciones:
    ./desplegar.sh {{opciones}}

# Solo pruebas
pruebas:
    ./desplegar.sh --solo-pruebas

apagar:
    ./crear-vms.sh --apagar

# Apaga y elimina los discos de las VM (la imagen base se conserva)
borrar:
    ./crear-vms.sh --borrar
