# =====================================================================
#  Lab 5 - Configuración compartida (SIN secretos). Todos usan lo mismo.
#  Las contraseñas van en secretos.env (no se sube al repo).
# =====================================================================

# --- Red host-only de VirtualBox (192.168.56.0/24) ---
RED_LAB="192.168.56.0/24"
HOST_IP="192.168.56.1"        # IP del host en la red host-only (Windows: .1 / en Mac sale .100)
WEB_IP="192.168.56.10"        # VM capa web
DB_IP="192.168.56.20"         # VM capa base de datos

WEB_HOSTNAME="lab5-web"
DB_HOSTNAME="lab5-db"

# --- Puertos no conocidos ---
SSH_PORT="22022"              # SSH/SFTP (en lugar de 22) en ambas VM
MYSQL_PORT="33306"            # MySQL (en lugar de 3306)

# --- Usuarios ---
SYSADMIN_USER="sysadmin"      # administrador del sistema (sudo), solo con llave SSH
SFTP_USER="wpadmin"           # ÚNICO usuario con escritura sobre WordPress (SFTP)

# --- Base de datos de WordPress (no es el root del motor) ---
DB_NAME="wordpress_db"
DB_USER="wp_user"

# --- Sitio ---
DOMINIO="redes-lab5-wp.duckdns.org" # subdominio DuckDNS del grupo
WP_DIR="/var/www/wordpress"
WP_TITULO="Lab 5 Redes - Grupo"
